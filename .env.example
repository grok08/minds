# GitHub (create a PAT at github.com/settings/tokens with repo, admin:repo_hook, actions:read scopes)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=minds-test-repo
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret-here

# ngrok (run: ngrok http 3000, copy the https URL)
NGROK_URL=https://abc123.ngrok.io

# PostgreSQL (local install)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minds
DB_USER=postgres
DB_PASSWORD=postgres